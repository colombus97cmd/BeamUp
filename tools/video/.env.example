# Robot de tournage BeamUp — copier ce fichier en .env.local (jamais commité) et compléter.
BEAMUP_URL=https://beamup.beautifull-earthcorp.tech
# Même valeur que la variable CRON_SECRET du projet Vercel beam-up.
CRON_SECRET=
# Morceau dont vous détenez les droits (le passage le plus énergique est choisi automatiquement).
MUSIQUE=C:\chemin\vers\morceau.m4a
NAVIGATEUR=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Démo de Chains & Crowns en mode démonstration (l'IA joue les deux camps).
JEU_URL=https://portfolio-2026-colombod.vercel.app/chains-and-crowns/index.html?demo=auto&niveau=1
